{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build:clean",
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "DISABLE_WEBPACK_CACHE": "true",
      "VERCEL_FORCE_NO_BUILD_CACHE": "1"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}